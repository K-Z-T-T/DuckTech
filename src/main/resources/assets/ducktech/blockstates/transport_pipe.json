{
  "multipart": [
    { "apply": { "model": "ducktech:block/transport_pipe" } },
    { "when": { "down": "true" }, "apply": { "model": "ducktech:block/transport_pipe_down" } },
    { "when": { "up": "true" }, "apply": { "model": "ducktech:block/transport_pipe_up" } },
    { "when": { "north": "true" }, "apply": { "model": "ducktech:block/transport_pipe_north" } },
    { "when": { "south": "true" }, "apply": { "model": "ducktech:block/transport_pipe_south" } },
    { "when": { "west": "true" }, "apply": { "model": "ducktech:block/transport_pipe_west" } },
    { "when": { "east": "true" }, "apply": { "model": "ducktech:block/transport_pipe_east" } }
  ]
}
